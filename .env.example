# Copie este arquivo para .env antes de rodar "docker compose up".
# No ambiente local os valores abaixo já funcionam sem alteração.

# Banco de dados (container db)
POSTGRES_USER=laboratorio
POSTGRES_PASSWORD=laboratorio
POSTGRES_DB=laboratorio
DATABASE_URL=postgresql://laboratorio:laboratorio@db:5432/laboratorio?schema=public

# API
API_PORT=3000
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=30m
WEB_URL=http://localhost:5173

# E-mail: localmente o Mailpit captura as mensagens (http://localhost:8025).
# Em produção, troque pelos dados do servidor SMTP real.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Laboratório <nao-responda@laboratorio.local>"

# Usuário inicial criado pelo seed
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@laboratorio.local
ADMIN_SENHA=Admin12345

# Front-end
VITE_API_URL=http://localhost:3000
